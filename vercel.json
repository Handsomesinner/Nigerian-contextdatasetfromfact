{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/verify", "destination": "/api/index" },
    { "source": "/api/predict", "destination": "/api/index" },
    { "source": "/", "destination": "/api/index" }
  ]
}
